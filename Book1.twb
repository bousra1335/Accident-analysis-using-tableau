      <aliases enabled='yes' />
      <column caption='Accident Severity' datatype='string' name='[Accident_Severity]' role='dimension' type='nominal' />
      <column caption='PY Accidents' datatype='integer' name='[CY Accidents (copy)_231653962338971651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count (IF &#10;YEAR([Accident Date]) = [Parameters].[Current Year (copy)_231653962337792001]&#10;THEN&#10;[Index]&#10;END)' />
      </column>
      <column caption='PY Casualties' datatype='integer' name='[CY Casualties (copy)_231653962344783878]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([Accident Date])= [Parameters].[Current Year (copy)_231653962337792001]&#10;THEN[Number_of_Casualties] END)' />
      </column>
      <column caption='PY Fatal Casualties ' datatype='integer' name='[CY Fatal Casualties (copy)_231653962346463241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [Accident_Severity]=&apos;Fatal&apos;&#10;and YEAR([Accident Date])= [Parameters].[Current Year (copy)_231653962337792001]&#10;THEN [Number_of_Casualties] END)' />
      </column>
      <column caption='CY Serious Casualties ' datatype='integer' name='[CY Fatal Casualties (copy)_231653962347335692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [Accident_Severity]=&apos;Serious&apos;&#10;and YEAR([Accident Date])=[Parameters].[Parameter 1]&#10;THEN [Number_of_Casualties] END)' />
      </column>
      <column caption='CY Slight Casualties  ' datatype='integer' name='[CY Serious Casualties  (copy)_84161074555498496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [Accident_Severity]=&apos;Slight&apos;&#10;and YEAR([Accident Date])=[Parameters].[Parameter 1]&#10;THEN [Number_of_Casualties] END)' />
      </column>
      <column aggregation='Sum' caption='Year of Accident Date' datatype='integer' name='[Calculation_231653962336362496]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='YEAR([Accident Date])' />
      </column>
      <column caption='CY Accidents' datatype='integer' name='[Calculation_231653962338107394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count (IF &#10;YEAR([Accident Date]) = [Parameters].[Parameter 1]&#10;THEN&#10;[Index]&#10;END)' />
      </column>
      <column caption='Year on Year Accidents' datatype='real' default-format='*🔼0.00%;🔽0.00%' name='[Calculation_231653962339405828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_231653962338107394]-[CY Accidents (copy)_231653962338971651])/[CY Accidents (copy)_231653962338971651]' />
      </column>
      <column caption='CY Casualties' datatype='integer' name='[Calculation_231653962343972869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([Accident Date])= [Parameters].[Parameter 1]&#10;THEN[Number_of_Casualties] END)' />
      </column>
      <column caption='CY Fatal Casualties' datatype='integer' name='[Calculation_231653962345951240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [Accident_Severity]=&apos;Fatal&apos;&#10;and YEAR([Accident Date])=[Parameters].[Parameter 1]&#10;THEN [Number_of_Casualties] END)' />
      </column>
      <column caption='Accident Severity Filter' datatype='boolean' name='[Calculation_82050012908269568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2]= [Accident_Severity]&#10;or [Parameters].[Parameter 2]=&quot;All&quot;' />
      </column>
      <column aggregation='Avg' datatype='real' name='[Latitude]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative' />
      <column caption='Light Conditions' datatype='string' name='[Light_Conditions]' role='dimension' type='nominal' />
      <column aggregation='Avg' datatype='real' name='[Longitude]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative' />
      <column caption='Number of Casualties' datatype='integer' name='[Number_of_Casualties]' role='measure' type='quantitative' />
      <column caption='Number of Vehicles' datatype='integer' name='[Number_of_Vehicles]' role='measure' type='quantitative' />
      <column caption='PY Serious Casualties  ' datatype='integer' name='[PY Fatal Casualties  (copy)_231653962347507725]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [Accident_Severity]=&apos;Serious&apos;&#10;and YEAR([Accident Date])= [Parameters].[Current Year (copy)_231653962337792001]&#10;THEN [Number_of_Casualties] END)' />
      </column>
      <column caption='PY Slight Casualties ' datatype='integer' name='[PY Serious Casualties   (copy)_84161074555674625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [Accident_Severity]=&apos;Slight&apos;&#10;and YEAR([Accident Date])= [Parameters].[Current Year (copy)_231653962337792001]&#10;THEN [Number_of_Casualties] END)' />
      </column>
      <column datatype='string' name='[Road Surface Conditions (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Road_Surface_Conditions]' new-bin='true'>
          <bin default-name='false' value='&quot;Frost/Snow&quot;'>
            <value>&quot;Frost or ice&quot;</value>
            <value>&quot;Snow&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Unknown&quot;'>
            <value>%null%</value>
          </bin>
          <bin default-name='false' value='&quot;Wet Surface&quot;'>
            <value>&quot;Flood over 3cm. deep&quot;</value>
            <value>&quot;Wet or damp&quot;</value>
          </bin>
        </calculation>
      </column>
